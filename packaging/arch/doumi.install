post_install() {
    # Update icon cache
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi

    # Update desktop database
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications 2>/dev/null || true
    fi

    cat << 'MSG'

  ╔══════════════════════════════════════════════════════════╗
  ║  Doumi installed!                                        ║
  ║                                                          ║
  ║  Quick start:                                            ║
  ║    doumi daemon start            start background daemon ║
  ║    doumi rules add MyRule -f ~/Downloads   create a rule ║
  ║    doumi rules list              view all rules          ║
  ║    doumi gui                     launch GTK4 GUI         ║
  ║    systemctl --user enable --now doumi  auto-start       ║
  ║                                                          ║
  ║  Config: ~/.config/doumi/                                ║
  ║  Logs:   doumi logs                                       ║
  ╚══════════════════════════════════════════════════════════╝

MSG
}

post_upgrade() {
    post_install
}

pre_remove() {
    # Stop any running doumid instances
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop doumi.service 2>/dev/null || true
        systemctl --user disable doumi.service 2>/dev/null || true
    fi
    pkill -f doumid 2>/dev/null || true
}

post_remove() {
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi
}
